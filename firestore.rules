rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() &&
             request.auth.token.admin == true;
    }

    match /posts/{id} {
      allow read: if resource.data.isPublished == true || admin();
      allow create, update, delete: if admin();
    }

    match /listings/{id} {
      allow read: if resource.data.isPublished == true || admin();
      allow create, update, delete: if admin();
    }

    match /comments/{id} {

      // Public visitors can only see approved comments.
      allow read: if resource.data.isApproved == true || admin();

      // Visitors can submit comments, but cannot approve themselves.
      allow create: if
        request.resource.data.keys().hasOnly([
          'postId',
          'displayName',
          'text',
          'isApproved',
          'isFlagged',
          'createdAt'
        ]) &&
        request.resource.data.postId is string &&
        request.resource.data.postId.size() > 0 &&
        request.resource.data.postId.size() <= 120 &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 2 &&
        request.resource.data.displayName.size() <= 60 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() >= 3 &&
        request.resource.data.text.size() <= 1000 &&
        request.resource.data.isApproved == false &&
        request.resource.data.isFlagged == false;

      // Only administrators can moderate or delete comments.
      allow update, delete: if admin();
    }

    // Private community & scholarly submissions:
    // NEVER publicly readable; only admins can read, approve, or publish.
    match /submissions/{id} {
      allow read: if admin();
      allow create: if
        request.resource.data.keys().size() <= 35 &&
        request.resource.data.status in ['Submitted', 'Pending Review'] &&
        request.resource.data.isApproved == false &&
        request.resource.data.isPublished == false &&
        request.resource.data.publishedPostId == null &&
        request.resource.data.consentToReview == true &&
        request.resource.data.consentToPublishIfApproved == true &&
        request.resource.data.rightsConfirmation == true &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 5 &&
        request.resource.data.title.size() <= 180 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() >= 30 &&
        request.resource.data.body.size() <= 12000 &&
        request.resource.data.state is string &&
        request.resource.data.state.size() >= 2 &&
        request.resource.data.state.size() <= 100 &&
        request.resource.data.ethnicGroup is string &&
        request.resource.data.ethnicGroup.size() >= 2 &&
        request.resource.data.ethnicGroup.size() <= 120 &&
        request.resource.data.sourcesAndReferences is string &&
        request.resource.data.sourcesAndReferences.size() >= 5 &&
        request.resource.data.sourcesAndReferences.size() <= 2500 &&
        (!('mediaUrl' in request.resource.data) ||
          (request.resource.data.mediaUrl is string &&
           request.resource.data.mediaUrl.size() <= 600 &&
           (request.resource.data.mediaUrl == '' ||
            request.resource.data.mediaUrl.matches('^https?://.*'))));
      allow update, delete: if admin();
    }

    // Private contributor correction, citation, and withdrawal requests:
    // Only administrators can read or resolve requests.
    match /correctionRequests/{id} {
      allow read, update, delete: if admin();
      allow create: if
        request.resource.data.keys().size() <= 15 &&
        request.resource.data.status == 'Pending Review' &&
        request.resource.data.referenceOrRecordId is string &&
        request.resource.data.referenceOrRecordId.size() >= 2 &&
        request.resource.data.referenceOrRecordId.size() <= 140 &&
        request.resource.data.details is string &&
        request.resource.data.details.size() >= 15 &&
        request.resource.data.details.size() <= 3000;
    }

    // External API discovered heritage records:
    // Public visitors can only read records approved for public display.
    match /externalDiscoveries/{id} {
      allow read: if
        (resource.data.status == 'Published' &&
         resource.data.isApprovedForPublic == true) ||
        admin();
      allow create, update, delete: if admin();
    }

    // Immutable administrative audit log:
    // Only administrators can read or append; nobody can overwrite or delete.
    match /auditLogs/{id} {
      allow read, create: if admin();
      allow update, delete: if false;
    }

    match /siteSettings/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /analytics/{id} {
      allow read, write: if admin();
    }

    match /contactRateLimits/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
