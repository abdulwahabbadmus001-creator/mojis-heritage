rules_version = '2';
service firebase.storage { match /b/{bucket}/o {
 function admin(){ return request.auth != null && request.auth.token.admin == true; }
 match /content/{allPaths=**} { allow read: if true; allow write: if admin() && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }
 match /{allPaths=**} { allow read,write: if false; }
}}
